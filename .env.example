# 复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# 仅在使用 Cloudflare R2 时配置；留空或 STORAGE_DRIVER=local 时走本地磁盘

# local | r2
STORAGE_DRIVER=local

# Cloudflare R2（S3 兼容）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 公网访问前缀（r2.dev 域名或绑定的自定义域名），用于前端预览
R2_PUBLIC_BASE=
# R2 存储配额（GB），仅用于图库页「存储剩余」展示；默认 10（免费额度）
R2_QUOTA_GB=10
