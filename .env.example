# 复制为 .env 并填入真实值（.env 已被 gitignore，不会提交）
# 以下所有变量都可省略：省略即使用注释里写的默认值。
# 仅在使用 Cloudflare R2 时需要配置 R2_*；留空或 STORAGE_DRIVER=local 时走本地磁盘。
#
# 本文件由 docker compose 读取，作为 docker-compose.yml 里 ${VAR:-默认} 的值。
# 应用本身不加载 .env（没有 dotenv）：直接 `node server.js` 时请自行导出环境变量。

# local | r2
STORAGE_DRIVER=local

# Cloudflare R2（S3 兼容）
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 公网访问前缀（r2.dev 域名或绑定的自定义域名），用于前端预览
R2_PUBLIC_BASE=
# R2 存储配额（GB），仅用于图库页「存储剩余」展示；默认 10（免费额度）
# 注意：这一项目前未写入 docker-compose.yml 的 environment，Docker 部署时不生效，需自行补一行。
R2_QUOTA_GB=10

# ---------------- 安全 / 访问控制 ----------------
# 本节变量已由 docker-compose.yml 的 environment 注入容器（默认值与下方注释一致），
# 写在 .env 即可生效；若自行增删 compose 的 environment 行，记得同步。
#
# 反向代理显式 opt-in：1 = 按最近一跳的 X-Forwarded-For 取客户端 IP。
# 部署在 nginx / Caddy 等反代后面时必须设为 1，并让反代清洗（覆盖）XFF，
# 否则登录限速的 IP 维度会退化成全局阈值（一个人输错就锁住所有人）。
# 默认 0（关闭）：此时客户端自带的 XFF 一律不采信，防止伪造绕限速。
# 只接受 0 / 1，其他值启动即失败。
TRUST_PROXY=0

# 账号 Cookie 自动续期：1 开启（检查 / 轮换 / 恢复），0 只关闭这条链，
# 保留 30 分钟巡检、扫码与失效提醒（恢复侧文件不删除）。只接受 0 / 1。
COOKIE_AUTO_REFRESH=1

# ---------------- 登录失败限速（进程内内存计数） ----------------
# 单用户名在窗口内的失败次数上限，达到即 429 + Retry-After（1-1000）
LOGIN_MAX_FAILURES=5
# 单 IP 在窗口内的失败次数上限（1-100000），默认比用户名维度宽松
LOGIN_MAX_FAILURES_IP=20
# 计数窗口（毫秒，1000-86400000），默认 15 分钟
LOGIN_WINDOW_MS=900000
# 单个维度计数表的最大条数（1-100000），超出先清过期项再丢最早的
LOGIN_THROTTLE_MAX_ENTRIES=5000

# ---------------- 缩略图（派生缓存） ----------------
# 1 开启（默认）；0 关闭并安全重定向到受鉴权的原图，仅用于故障降级
THUMB_ENABLED=1
# 生成全过程并发（1-2）
THUMB_CONCURRENCY=2
# 派生缓存上限（MiB，1-4096）
THUMB_CACHE_MAX_MB=512
# 未访问回收天数（1-365）
THUMB_CACHE_DAYS=30
# 源读取 / 转码限时（毫秒，100-10000）
THUMB_FETCH_TIMEOUT_MS=10000
